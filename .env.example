PORT=3000
GRPC_PORT=50051
GRPC_BIND_ADDRESS=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_service?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_SECRET=replace-with-a-different-32-character-random-secret
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
CORS_ORIGIN=http://localhost:3000
# In development without SMTP, OTPs are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
